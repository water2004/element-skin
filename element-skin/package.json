{
  "name": "element-skin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only",
    "build-fast": "npm run build-only",
    "test": "vitest run",
    "test:coverage:oauth": "run-s test:coverage:oauth-api test:coverage:oauth-ui",
    "test:coverage:oauth-api": "vitest run src/api/__tests__/api.test.ts --coverage --coverage.include=src/api/oauth/apps.ts --coverage.thresholds.100 --coverage.reportsDirectory=coverage/oauth-api",
    "test:coverage:oauth-ui": "vitest run --config vitest.oauth-coverage.config.ts --coverage",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/markdown-it": "^14.1.2",
    "axios": "^1.18.1",
    "dompurify": "^3.4.11",
    "element-plus": "^2.3.10",
    "markdown-it": "^14.2.0",
    "matter-js": "^0.20.0",
    "pinia": "^3.0.4",
    "skinview3d": "^3.4.1",
    "three": "^0.156.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.1.5"
  }
}
